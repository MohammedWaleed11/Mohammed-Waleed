{{ 'gift-guide-banner.css' | asset_url | stylesheet_tag }}

<div class="gift-banner">
  <div class="gift-banner__content">
    <h1 class="gift-banner__heading">{{ section.settings.heading }}</h1>
    <div class="gift-banner__description">{{ section.settings.description }}</div>
    <a href="{{ section.settings.button_link }}" class="gift-banner__button">
      {{ section.settings.button_text }}
      <span class="gift-banner__button-arrow">→</span>
    </a>
  </div>

  <div class="gift-banner__image-wrapper">
    {% if section.settings.image %}
      <img
        src="{{ section.settings.image | image_url: width: 1500 }}"
        alt="{{ section.settings.image.alt | escape }}"
        class="gift-banner__image"
        loading="eager"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
      >
    {% endif %}
  </div>
</div>

{% if section.settings.strip_text != blank %}
  <div class="gift-banner__strip">
    {{ section.settings.strip_text }}
  </div>
{% endif %}

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    },
    {
      "type": "text",
      "id": "strip_text",
      "label": "Bottom strip text",
      "default": "Sustainable, ethically made clothes in sizes XXS to 6XL"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}